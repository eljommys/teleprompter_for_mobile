{
  "expo": {
    "name": "Prompter",
    "slug": "teleprompter_for_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rackslabs.prompter",
      "appleTeamId": "25G3Q8388L",
      "infoPlist": {
        "NSCameraUsageDescription": "To record you while you read the script.",
        "NSMicrophoneUsageDescription": "To record your voice along with the video.",
        "NSPhotoLibraryAddUsageDescription": "To save your takes to your Photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rackslabs.prompter",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "To save your takes to your Photos.",
          "savePhotosPermission": "To save your takes to your Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "820acea3-dd8b-4fce-8bd1-7f5061fb3496"
      }
    },
    "owner": "jaimeracks"
  }
}
